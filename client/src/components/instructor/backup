import React, { useEffect, useState, useCallback } from 'react';
import { useDispatch, useSelector } from 'react-redux';
import { getCourseStudents } from '../../features/course/courseSlice';
import { X, Calendar, Award, Clock, Users, ChevronLeft, ChevronRight } from 'lucide-react';

const LIMIT = 8;

const CourseStudentsModal = ({ isOpen, onClose, courseId, courseTitle }) => {
  const dispatch = useDispatch();
  const { courseStudents, courseStudentsPagination, isStudentsLoading } = useSelector((s) => s.course);
  const [page, setPage] = useState(1);

  // Single effect: fetch khi mở modal, hoặc khi courseId / page thay đổi
  useEffect(() => {
    if (!isOpen || !courseId) return;
    dispatch(getCourseStudents({ courseId, params: { page, limit: LIMIT } }));
  }, [dispatch, isOpen, courseId, page]);

  // Reset page về 1 khi chuyển sang course khác (không reset khi page thay đổi)
  const prevCourseIdRef = React.useRef(null);
  useEffect(() => {
    if (isOpen && courseId && courseId !== prevCourseIdRef.current) {
      prevCourseIdRef.current = courseId;
      setPage(1);
    }
    if (!isOpen) {
      prevCourseIdRef.current = null;
    }
  }, [isOpen, courseId]);

  if (!isOpen) return null;

  // ── Formatters ──────────────────────────────────────────────────────────────
  const formatDate = (dateStr) => {
    if (!dateStr) return '--/--/----';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return '--/--/----';
    return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
  };

  const formatTimeAgo = (dateStr) => {
    if (!dateStr) return 'Chưa học';
    const date = new Date(dateStr);
    if (isNaN(date.getTime())) return 'Chưa học';
    const seconds = Math.floor((new Date() - date) / 1000);
    if (seconds < 60) return 'Vừa xong';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes} phút trước`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours} giờ trước`;
    const days = Math.floor(hours / 24);
    if (days === 1) return 'Hôm qua';
    if (days < 7) return `${days} ngày trước`;
    return formatDate(dateStr);
  };

  // ── Avatar ──────────────────────────────────────────────────────────────────
  const renderAvatar = (student) => {
    if (student?.avatar) {
      return (
        <img
          src={student.avatar}
          alt={student.name}
          className="w-10 h-10 rounded-full object-cover border border-gray-100 flex-shrink-0"
          onError={(e) => { e.target.onerror = null; e.target.src = '/default-avatar.svg'; }}
        />
      );
    }
    const initial = student?.name ? student.name.charAt(0).toUpperCase() : '?';
    const colors = [
      'bg-rose-100 text-rose-700',
      'bg-blue-100 text-blue-700',
      'bg-emerald-100 text-emerald-700',
      'bg-amber-100 text-amber-700',
      'bg-purple-100 text-purple-700',
      'bg-indigo-100 text-indigo-700',
      'bg-pink-100 text-pink-700',
      'bg-teal-100 text-teal-700',
    ];
    return (
      <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0 ${colors[initial.charCodeAt(0) % colors.length]}`}>
        {initial}
      </div>
    );
  };

  // ── Skeleton ─────────────────────────────────────────────────────────────────
  const Skeletons = () => (
    <div className="space-y-2 px-6 py-4">
      {Array.from({ length: 5 }).map((_, i) => (
        <div key={i} className="flex items-center gap-4 p-3 rounded-2xl animate-pulse">
          <div className="w-10 h-10 rounded-full bg-gray-100 flex-shrink-0" />
          <div className="flex-1 space-y-1.5">
            <div className="h-3.5 w-36 bg-gray-100 rounded" />
            <div className="h-2.5 w-24 bg-gray-50 rounded" />
          </div>
          <div className="h-3 w-20 bg-gray-100 rounded" />
          <div className="h-2 w-28 bg-gray-100 rounded-full" />
          <div className="h-5 w-16 bg-gray-50 rounded-full" />
        </div>
      ))}
    </div>
  );

  // ── Pagination values ────────────────────────────────────────────────────────
  const totalPages = courseStudentsPagination?.totalPages ?? 1;
  const totalItems = courseStudentsPagination?.totalItems ?? 0;
  const hasPrev = page > 1;
  const hasNext = page < totalPages;

  const handlePageChange = (newPage) => {
    if (newPage < 1 || newPage > totalPages) return;
    setPage(newPage);
  };

  // Build visible page numbers (max 5 buttons, centered around current page)
  const getPageNumbers = () => {
    if (totalPages <= 5) return Array.from({ length: totalPages }, (_, i) => i + 1);
    const half = 2;
    let start = Math.max(1, page - half);
    let end = Math.min(totalPages, page + half);
    if (page - half < 1) end = Math.min(totalPages, end + (half - (page - 1)));
    if (page + half > totalPages) start = Math.max(1, start - (half - (totalPages - page)));
    return Array.from({ length: end - start + 1 }, (_, i) => start + i);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
      {/* Backdrop */}
      <div
        className="fixed inset-0 bg-black/60 backdrop-blur-sm"
        onClick={onClose}
      />

      {/* Modal */}
      <div className="relative bg-white rounded-3xl shadow-2xl border border-gray-100 w-full max-w-4xl max-h-[88vh] flex flex-col overflow-hidden">

        {/* ── Header ── */}
        <div className="flex-shrink-0 px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gradient-to-r from-gray-50 to-white">
          <div className="flex items-center gap-3 min-w-0">
            <div className="w-10 h-10 bg-rose-50 rounded-xl flex items-center justify-center text-rose-600 flex-shrink-0">
              <Users size={20} />
            </div>
            <div className="min-w-0">
              <h2 className="text-lg font-black text-gray-900 leading-none">Học viên đã đăng ký</h2>
              <p className="text-xs text-gray-400 mt-1 truncate max-w-xs sm:max-w-md" title={courseTitle}>
                Khóa học: <span className="font-semibold text-gray-600">{courseTitle}</span>
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="ml-4 flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer"
          >
            <X size={18} />
          </button>
        </div>

        {/* ── Body (scrollable) ── */}
        <div className="flex-1 overflow-y-auto min-h-0">
          {isStudentsLoading ? (
            <Skeletons />
          ) : courseStudents.length > 0 ? (
            <div className="overflow-x-auto">
              <table className="w-full text-left border-collapse min-w-[580px]">
                <thead className="sticky top-0 bg-white z-10">
                  <tr className="border-b border-gray-100 text-[11px] font-bold uppercase tracking-wider text-gray-400">
                    <th className="py-3 px-6">Học viên</th>
                    <th className="py-3 px-4">
                      <div className="flex items-center gap-1"><Calendar size={12} /> Ngày đăng ký</div>
                    </th>
                    <th className="py-3 px-4">
                      <div className="flex items-center gap-1"><Award size={12} /> Tiến độ</div>
                    </th>
                    <th className="py-3 px-4">
                      <div className="flex items-center gap-1"><Clock size={12} /> Hoạt động gần nhất</div>
                    </th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-50 text-sm">
                  {courseStudents.map((item, idx) => (
                    <tr
                      key={item.student?._id ?? idx}
                      className="hover:bg-rose-50/30 transition-colors group"
                    >
                      {/* Student */}
                      <td className="py-3 px-6">
                        <div className="flex items-center gap-3">
                          {renderAvatar(item.student)}
                          <div className="min-w-0">
                            <p className="font-semibold text-gray-800 truncate group-hover:text-rose-600 transition-colors">
                              {item.student?.name || 'Học viên ẩn danh'}
                            </p>
                            <p className="text-xs text-gray-400 truncate">{item.student?.email || '—'}</p>
                          </div>
                        </div>
                      </td>

                      {/* Enrolled At */}
                      <td className="py-3 px-4 text-gray-500 text-xs font-medium whitespace-nowrap">
                        {formatDate(item.enrolledAt)}
                      </td>

                      {/* Progress */}
                      <td className="py-3 px-4">
                        <div className="flex items-center gap-2 w-36">
                          <div className="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                            <div
                              className="h-full bg-rose-500 rounded-full transition-all duration-700"
                              style={{ width: `${item.progress?.percentage ?? 0}%` }}
                            />
                          </div>
                          <span className="text-xs font-bold text-gray-700 w-8 text-right tabular-nums">
                            {item.progress?.percentage ?? 0}%
                          </span>
                        </div>
                      </td>

                      {/* Last Active */}
                      <td className="py-3 px-4">
                        <span className="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-500 whitespace-nowrap">
                          {formatTimeAgo(item.progress?.updatedAt)}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div className="flex flex-col items-center justify-center py-20 text-center">
              <div className="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center text-gray-200 mb-4 border border-dashed border-gray-200">
                <Users size={28} />
              </div>
              <h3 className="text-base font-bold text-gray-600 mb-1">Chưa có học viên</h3>
              <p className="text-xs text-gray-400 max-w-[260px]">
                Chưa có học viên nào đăng ký khóa học này.
              </p>
            </div>
          )}
        </div>

        {/* ── Footer Pagination (luôn render khi có dữ liệu, dù 1 hay nhiều trang) ── */}
        {!isStudentsLoading && totalItems > 0 && (
          <div className="flex-shrink-0 border-t border-gray-100 px-6 py-3 bg-gray-50/60 flex items-center justify-between gap-4">
            {/* Info text */}
            <p className="text-xs text-gray-400 whitespace-nowrap">
              Tổng <span className="font-semibold text-gray-700">{totalItems}</span> học viên
              {totalPages > 1 && (
                <> · Trang <span className="font-semibold text-gray-700">{page}</span>/<span className="font-semibold text-gray-700">{totalPages}</span></>
              )}
            </p>

            {/* Page buttons — chỉ hiện khi có nhiều hơn 1 trang */}
            {totalPages > 1 && (
              <div className="flex items-center gap-1">
                {/* Prev */}
                <button
                  onClick={() => handlePageChange(page - 1)}
                  disabled={!hasPrev}
                  className="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 border border-gray-200 bg-white hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed transition cursor-pointer"
                >
                  <ChevronLeft size={15} />
                </button>

                {/* Page numbers */}
                {getPageNumbers().map((p) => (
                  <button
                    key={p}
                    onClick={() => handlePageChange(p)}
                    className={`w-8 h-8 rounded-lg text-xs font-bold flex items-center justify-center transition cursor-pointer ${p === page
                        ? 'bg-rose-500 text-white shadow-sm shadow-rose-200 border border-rose-500'
                        : 'border border-gray-200 bg-white text-gray-600 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200'
                      }`}
                  >
                    {p}
                  </button>
                ))}

                {/* Next */}
                <button
                  onClick={() => handlePageChange(page + 1)}
                  disabled={!hasNext}
                  className="w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 border border-gray-200 bg-white hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed transition cursor-pointer"
                >
                  <ChevronRight size={15} />
                </button>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
};

export default CourseStudentsModal;
